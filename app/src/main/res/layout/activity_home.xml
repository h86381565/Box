<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="#07080F"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="#10111A"
        android:padding="14dp"
        android:layout_width="200dp"
        android:layout_height="match_parent">

        <TextView android:id="@+id/tvName" android:text="VIP影库 ULTRA BOX PRO" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_vip_pro" android:padding="10dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="★ 超级VIP PRO" android:textColor="#FFD76D" android:textSize="10sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvVipExpire" android:text="至 2027-09-11 · 无限观影" android:textColor="#8B8DA0" android:textSize="9sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewCategory" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" android:clipChildren="false" android:clipToPadding="false"/>

        <TextView android:id="@+id/tvMenu" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>
        <TextView android:id="@+id/tvDrawer" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>
        <TextView android:id="@+id/tvStyle" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/contentLayout" android:orientation="vertical" android:background="#000000" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">

        <LinearLayout android:id="@+id/topLayout" android:orientation="horizontal" android:gravity="center_vertical" android:background="#07080F" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_width="match_parent" android:layout_height="38dp">

            <!-- 搜索按钮用 tvFind，Java里已经改为跳搜索 -->
            <LinearLayout android:id="@+id/tvFind" android:orientation="horizontal" android:gravity="center_vertical" android:focusable="true" android:clickable="true" android:background="@drawable/bg_search_icon" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_width="wrap_content" android:layout_height="28dp">
                <TextView android:text="🔍" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="搜索" android:textColor="#9AA0B5" android:textSize="10sp" android:layout_marginStart="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 保留 tvWifi 隐藏，防止 findViewById null，但也指向搜索 -->
            <View android:id="@+id/tvWifi" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp"/>

            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>

            <LinearLayout android:background="@drawable/bg_date_premium" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="22dp">
                <TextView android:id="@+id/tvDate" android:text="09月12日 | 周六 14:10" android:textColor="#E6E8F0" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager android:id="@+id/mViewPager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:background="#000000"/>
    </LinearLayout>
</LinearLayout>
